{
  "description": "qoder-basic Qoder lifecycle hooks",
  "hooks": {
    "SessionStart": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "${QODER_PLUGIN_ROOT}/bin/qoder-basic-hook",
            "args": ["session-start"],
            "name": "qoder-basic-session-start",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "${QODER_PLUGIN_ROOT}/bin/qoder-basic-hook",
            "args": ["user-prompt-submit"],
            "name": "qoder-basic-user-prompt-submit",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "${QODER_PLUGIN_ROOT}/bin/qoder-basic-hook",
            "args": ["post-tool-use"],
            "name": "qoder-basic-post-tool-use",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "${QODER_PLUGIN_ROOT}/bin/qoder-basic-hook",
            "args": ["stop"],
            "name": "qoder-basic-stop",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
