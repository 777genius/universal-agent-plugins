{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "uap_public_probe": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "${PLUGIN_ROOT}/main.go"
      ],
      "env": {
        "GOTOOLCHAIN": "local",
        "GOWORK": "off"
      }
    }
  }
}
