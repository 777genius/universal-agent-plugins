{
  "name": "plugin-kit-ai-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": "22.21.1",
    "pnpm": "8.15.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "dompurify": "3.4.13",
      "lodash-es": "4.18.1",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "uuid": "14.0.1"
    }
  },
  "scripts": {
    "docs:clean": "node ./tools/clean.mjs",
    "docs:test": "node --test ./tools/lib/frontmatter.test.mjs ./tools/quality/check-output.test.mjs ./tools/quality/public-authoring-links.test.mjs && node ./tools/quality/test-site-consumer.mjs",
    "docs:gen": "node ./tools/generate.mjs",
    "docs:build": "pnpm run docs:gen && vitepress build && node ./tools/postbuild.mjs",
    "docs:dev": "pnpm run docs:gen && vitepress dev",
    "docs:preview": "vitepress preview",
    "docs:check-locale": "node ./tools/quality/check-locale.mjs",
    "docs:check-model": "node ./tools/quality/check-model.mjs",
    "docs:check-public-boundary": "node ./tools/quality/check-public-boundary.mjs",
    "docs:check-drift": "node ./tools/quality/check-drift.mjs",
    "docs:check-output": "node ./tools/quality/check-output.mjs",
    "docs:smoke-ui": "node ./tools/quality/check-ui.mjs",
    "docs:check-ui": "pnpm run docs:build && pnpm run docs:smoke-ui",
    "docs:check": "pnpm run docs:test && pnpm run docs:gen && pnpm run docs:check-locale && pnpm run docs:check-model && pnpm run docs:check-public-boundary && pnpm run docs:check-drift && vitepress build && node ./tools/postbuild.mjs && pnpm run docs:check-output"
  },
  "devDependencies": {
    "mermaid": "11.17.0",
    "playwright": "1.62.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "vitepress": "2.0.0-alpha.18",
    "vitepress-codeblock-collapse": "1.0.0",
    "vitepress-mermaid-zoom": "1.0.2",
    "vue": "3.5.40"
  }
}
