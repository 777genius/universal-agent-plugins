+"""Marker capture may finish after the console owner process exits."""
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from windows_conpty import ConPTY
+
+
+class CaptureTests(unittest.TestCase):
+    def setUp(self):
+        self.now = 0
+        self.on_sleep = lambda: None
+        clock = SimpleNamespace(monotonic=lambda: self.now, sleep=self.sleep)
+        mocked = patch('windows_conpty.time', clock)
+        mocked.start()
+        self.addCleanup(mocked.stop)
+        self.console = ConPTY.__new__(ConPTY)
+        self.console.timeout = 1
+        self.console.error = None
+        self.console.raw = bytearray()
+        self.console.status_path = None
+        self.console.poll = lambda: 0
+        self.console.reader = SimpleNamespace(is_alive=lambda: True)
+
+    def sleep(self, duration):
+        self.now += duration
+        self.on_sleep()
+
+    def capture_during_poll(self):
+        self.console.raw.extend(b'RESTORE_OK_test\r\n')
+        return 0
+
+    def test_marker_captured_during_exit_poll(self):
+        self.console.poll = self.capture_during_poll
+        self.assertGreater(self.console.wait('RESTORE_OK_test'), 0)
+
+    def test_reader_delivers_after_process_exit(self):
+        def capture():
+            if self.now >= .06:
+                self.console.raw.extend(b'RESTORE_OK_test\r\n')
+        self.on_sleep = capture
+        self.assertGreater(self.console.wait('RESTORE_OK_test'), 0)
+        self.assertLess(self.now, self.console.timeout)
+
+    def test_rescan_after_reader_finishes(self):
+        self.console.reader.is_alive = lambda: False
+        self.console.poll = self.capture_during_poll
+        self.assertGreater(self.console.wait('RESTORE_OK_test'), 0)
+        self.assertEqual(self.now, 0)
+
+    def test_finished_reader_without_marker_fails(self):
+        self.console.reader.is_alive = lambda: False
+        with self.assertRaisesRegex(AssertionError, 'exited'):
+            self.console.wait('RESTORE_OK_test')
+        self.assertEqual(self.now, 0)
+
+    def test_missing_marker_keeps_original_deadline(self):
+        with self.assertRaisesRegex(AssertionError, 'timeout waiting'):
+            self.console.wait('RESTORE_OK_test')
+        self.assertGreaterEqual(self.now, self.console.timeout)
+        self.assertLess(self.now, self.console.timeout + .021)
+
+    def test_capture_at_or_after_deadline_fails(self):
+        def capture():
+            if self.now >= self.console.timeout:
+                self.console.raw.extend(b'RESTORE_OK_test\r\n')
+        self.on_sleep = capture
+        with self.assertRaisesRegex(AssertionError, 'timeout waiting'):
+            self.console.wait('RESTORE_OK_test')
+
+    def test_reader_error_remains_failure(self):
+        self.console.error = 'ReadFile WinError 6'
+        with self.assertRaisesRegex(AssertionError, 'ReadFile WinError 6'):
+            self.console.wait('RESTORE_OK_test')
+
+
+if __name__ == '__main__':
+    unittest.main()
