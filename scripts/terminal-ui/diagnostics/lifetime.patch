+//go:build windows && terminaldiagnostic
+
+package promptio
+
+// Temporary experiment only. The workflow links one policy into each binary;
+// the isolated driver does not inherit arbitrary environment variables.
+import (
+	"fmt"
+	"runtime"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+var diagnosticLifetime = "baseline"
+
+// Go documents that package initialization runs on the startup OS thread.
+// runtime.mexit parks that particular thread instead of terminating it.
+var diagnosticInitialThread = windows.GetCurrentThreadId()
+
+var diagnosticGetThreadID = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetThreadId")
+var diagnosticCompareHandles = windows.NewLazySystemDLL("kernelbase.dll").NewProc("CompareObjectHandles")
+
+func diagnosticRetiresThread() bool {
+	return diagnosticLifetime == "retired-noninitial" || diagnosticLifetime == "fresh-input-retired"
+}
+
+func diagnosticOnReaderThread(excludeInitial bool, run func()) {
+	runtime.LockOSThread()
+	if excludeInitial && windows.GetCurrentThreadId() == diagnosticInitialThread {
+		// Keep m0 occupied until another locked thread has accepted the work.
+		// Unlocking before the handshake would let the child run on m0 again.
+		handed := make(chan struct{})
+		go func() {
+			runtime.LockOSThread()
+			if windows.GetCurrentThreadId() == diagnosticInitialThread {
+				panic("diagnostic: reader still on initial thread")
+			}
+			close(handed)
+			run()
+		}()
+		select {
+		case <-handed:
+		case <-time.After(250 * time.Millisecond):
+			panic("diagnostic: noninitial thread handoff exceeded 250ms")
+		}
+		runtime.UnlockOSThread()
+		return
+	}
+	// run owns unlocking, or returns locked to retire this noninitial thread.
+	run()
+}
+
+func diagnosticOpenConsole(inherited windows.Handle, mode uint32) (windows.Handle, error) {
+	var h windows.Handle
+	var err error
+	if diagnosticLifetime == "fresh-input" || diagnosticLifetime == "fresh-input-retired" {
+		// DuplicateHandle preserves the file object. A new CONIN$ open gives
+		// this request its own handle state and a final-close notification.
+		// This branch is reached only after validating inherited console input.
+		h, err = windows.CreateFile(windows.StringToUTF16Ptr("CONIN$"),
+			windows.GENERIC_READ|windows.GENERIC_WRITE,
+			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE,
+			nil, windows.OPEN_EXISTING, 0, 0)
+	} else {
+		p := windows.CurrentProcess()
+		err = windows.DuplicateHandle(p, inherited, p, &h, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	}
+	if err != nil {
+		return 0, err
+	}
+	var got uint32
+	if err = windows.GetConsoleMode(h, &got); err != nil || got != mode {
+		windows.CloseHandle(h)
+		return 0, fmt.Errorf("diagnostic console mode: inherited=%#x opened=%#x err=%v", mode, got, err)
+	}
+	if diagnosticCompareHandles.Find() == nil {
+		same, _, _ := diagnosticCompareHandles.Call(uintptr(inherited), uintptr(h))
+		traceConsole("object comparison inherited=%d owned=%d same=%t policy=%s", inherited, h, same != 0, diagnosticLifetime)
+	}
+	return h, nil
+}
+
+// The preflight performs no console I/O. It tests the exact duplicate/wait
+// access, a live-thread timeout, a noninitial ID and real termination before
+// the cancellation sweep can begin. Every wait has an explicit failure bound.
+func diagnosticThreadPreflight() error {
+	switch diagnosticLifetime {
+	case "baseline", "retired-noninitial", "fresh-input", "fresh-input-retired":
+	default:
+		return fmt.Errorf("unknown lifetime policy %q", diagnosticLifetime)
+	}
+	type info struct {
+		h   windows.Handle
+		id  uint32
+		err error
+	}
+	ready := make(chan info, 1)
+	release := make(chan struct{})
+	go diagnosticOnReaderThread(true, func() {
+		var h windows.Handle
+		p := windows.CurrentProcess()
+		err := windows.DuplicateHandle(p, windows.CurrentThread(), p, &h, 0, false, windows.DUPLICATE_SAME_ACCESS)
+		ready <- info{h, windows.GetCurrentThreadId(), err}
+		if err != nil {
+			runtime.UnlockOSThread()
+			return
+		}
+		<-release
+		// Intentionally return locked, on a verified noninitial thread.
+	})
+	var v info
+	select {
+	case v = <-ready:
+	case <-time.After(250 * time.Millisecond):
+		panic("diagnostic: preflight thread did not become ready in 250ms")
+	}
+	if v.err != nil {
+		return v.err
+	}
+	defer windows.CloseHandle(v.h)
+	id, _, idErr := diagnosticGetThreadID.Call(uintptr(v.h))
+	live, liveErr := windows.WaitForSingleObject(v.h, 0)
+	close(release)
+	exit, exitErr := windows.WaitForSingleObject(v.h, 250)
+	traceConsole("preflight policy=%s initial_tid=%d worker_tid=%d handle_tid=%d live=%d live_err=%v exit=%d exit_err=%v", diagnosticLifetime, diagnosticInitialThread, v.id, id, live, liveErr, exit, exitErr)
+	if uint32(id) != v.id || v.id == diagnosticInitialThread {
+		return fmt.Errorf("preflight thread identity initial=%d worker=%d handle=%d err=%v", diagnosticInitialThread, v.id, id, idErr)
+	}
+	if liveErr != nil || live != uint32(windows.WAIT_TIMEOUT) || exitErr != nil || exit != windows.WAIT_OBJECT_0 {
+		return fmt.Errorf("preflight thread wait live=%d err=%v exit=%d err=%v", live, liveErr, exit, exitErr)
+	}
+	return nil
+}
+
+func diagnosticWatchdog(phase string, bound time.Duration) func() {
+	timer := time.AfterFunc(bound, func() {
+		traceConsole("BOUND_EXCEEDED phase=%s bound=%s", phase, bound)
+		// Never return success or allow another read after a failed join.
+		panic(fmt.Sprintf("diagnostic: %s exceeded %s", phase, bound))
+	})
+	return func() { timer.Stop() }
+}
